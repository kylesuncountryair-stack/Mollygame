generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  // Can sign in and play like a regular player, but has no admin access and
  // is excluded from the leaderboard/rankings — for team leads or coaches
  // who shouldn't be competing for logs. Only reachable by an admin
  // promoting an existing player from the admin console; nobody signs up
  // as a MANAGER directly.
  MANAGER
  ADMIN
}

enum QuestionType {
  DAILY
  WEEKLY
  // A special one-off question, scheduled like a DAILY question, offered
  // only to the first player who answers that day's active DAILY question.
  // Always worth a fixed 3 logs regardless of its own logsReward value —
  // enforced server-side in the answer API route.
  BONUS
}

// Controls how a question is presented and answered. TRUE_FALSE questions
// still use the same options/correctIndex columns as MULTIPLE_CHOICE (always
// exactly ["True", "False"]) — this only changes the admin/player UI, not
// the scoring logic in the answer API route.
enum QuestionFormat {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum TransactionType {
  QUESTION_CORRECT
  ADMIN_GRANT
  ADMIN_ADJUST
  SPARK_CHAIN
  STREAK_BONUS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  passwordSalt String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())
  // Self-service avatar customization (Profile page). avatarColor is a key
  // into the palette in src/components/Avatar.tsx; avatarIcon is either
  // "initials" (default), "letter", or one of the 10 icon keys. Both are
  // nullable so existing accounts fall back to the old deterministic look.
  avatarColor  String?
  avatarIcon   String?
  // One-time first-login walkthrough (tiers, streaks, spark chains, circles).
  // Flips to true the first time the player dismisses/completes it.
  hasSeenOnboarding Boolean @default(false)

  answers             Answer[]
  logTransactions     LogTransaction[] @relation("PlayerTransactions")
  issuedTransactions  LogTransaction[] @relation("IssuedByAdmin")
  following           Follow[]         @relation("Follower")
  followedBy          Follow[]         @relation("Following")
}

model Question {
  id           String         @id @default(cuid())
  type         QuestionType
  format       QuestionFormat @default(MULTIPLE_CHOICE)
  prompt       String
  options      Json
  correctIndex Int
  // Optional admin-authored note shown to players who answer incorrectly,
  // explaining why the correct option is right. Never sent to the client
  // until after they've submitted an answer, so it can't be peeked at
  // beforehand.
  explanation  String?
  logsReward   Int            @default(1)
  activeDate   DateTime
  createdAt    DateTime       @default(now())

  answers Answer[]

  @@index([type, activeDate])
}

model Answer {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  logsAwarded   Int
  answeredAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model LogTransaction {
  id         String          @id @default(cuid())
  userId     String
  amount     Int
  reason     String
  type       TransactionType
  issuedById String?
  createdAt  DateTime        @default(now())

  user     User  @relation("PlayerTransactions", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("IssuedByAdmin", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// A player following another player just to watch their rank on a small,
// friendlier "mini leaderboard" on the dashboard. One-directional and
// doesn't require the other person's approval — low stakes, internal game.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// Records that a "spark chain" bonus already fired between this pair of
// players for this round of questions, so the check in
// src/lib/sparkChain.ts doesn't hand out the bonus more than once per pair
// per round. userAId/userBId are stored in sorted order (not
// follower/following order) since the pair is unordered for this purpose —
// no relation fields to User, kept as plain columns to avoid touching the
// User model's relation lists for what's a lightweight, best-effort feature.
model SparkChain {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  // Legacy: sparks used to be matched on "answered something correctly the
  // same day" (Central time), then briefly on "answered this exact
  // question" (which let one round with several questions — e.g. 2 dailies
  // + a bonus — spark repeatedly). Kept nullable so old rows from either of
  // those systems stay intact for history; no longer set on new rows.
  dateKey    String?
  questionId String?
  // Sparks are now matched on the ROUND of questions, keyed by the
  // question's scheduled activeDate rather than the exact question or the
  // day it was actually answered. This gets both halves of the original
  // problem right: (a) daily questions aren't scheduled every day and stay
  // answerable for a while after (see getActiveDailyQuestions' carry-
  // forward behavior), so two coworkers can land on the same round a day or
  // two apart and should still spark, and (b) a round can include more than
  // one question (multiple dailies, or a daily plus that day's bonus), and
  // all of those share one round — so it's still just one spark, not one
  // per question. Required on every row created going forward; null only
  // on legacy rows from before this switch.
  roundDate DateTime?
  createdAt DateTime @default(now())

  @@unique([userAId, userBId, roundDate])
  @@index([roundDate])
  @@index([questionId])
  @@index([dateKey])
}
